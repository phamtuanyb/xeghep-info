# ============================================================
# Biến môi trường — Nền tảng website xe ghép (white-label)
# Sao chép file này thành .env và điền giá trị thật.
# KHÔNG commit file .env vào git.
# ============================================================

# Kết nối PostgreSQL (Prisma)
# Tải cao: DATABASE_URL đi qua PgBouncer (thêm ?pgbouncer=true&connection_limit=1),
# DIRECT_URL là kết nối trực tiếp cho migrate. Local: hai URL giống nhau.
DATABASE_URL="postgresql://xeghep:xeghep@localhost:5440/xeghep_whitelabel?schema=public"
DIRECT_URL="postgresql://xeghep:xeghep@localhost:5440/xeghep_whitelabel?schema=public"

# JWT — BẮT BUỘC ở production, độ dài >= 32 ký tự
JWT_SECRET="thay-bang-chuoi-bi-mat-ngau-nhien-it-nhat-32-ky-tu"

# Tên miền gốc để dựng subdomain: <slug>.<ROOT_DOMAIN>
# Free: <slug>.xeghep.info | Pro: subdomain + tên miền riêng (xem DEPLOY.md)
ROOT_DOMAIN="xeghep.info"

# URL gốc của ứng dụng (dùng cho link tuyệt đối, email, sitemap)
# Production: https://xeghep.info
APP_BASE_URL="http://localhost:3000"

# IP công khai của VPS — hiện trong hướng dẫn DNS cho khách Pro (bản ghi A trỏ tên miền riêng về VPS)
PLATFORM_SERVER_IP=""

# ----- Tích hợp cấp nền tảng (mặc định; tenant có thể tự nhập token riêng trong DB) -----

# Telegram Bot — gửi lead/đặt xe (token mặc định cấp nền tảng)
TELEGRAM_BOT_TOKEN=""

# Gửi email đặt lại mật khẩu (Resend) hoặc dùng SMTP riêng
RESEND_API_KEY=""

# Redis — rate-limit / cache (môi trường tải cao)
REDIS_URL="redis://localhost:6399"
